{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "debug",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "OFF",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/deps/prefix",
        "QML_IMPORT_PATH": "${sourceDir}/build/deps/prefix/lib/qt6/qml"
      },
      "environment": {
        "QML_IMPORT_PATH": "${sourceDir}/build/deps/prefix/lib/qt6/qml",
        "LD_LIBRARY_PATH": "${sourceDir}/build/deps/prefix/lib"
      }
    },
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/deps/prefix",
        "QML_IMPORT_PATH": "${sourceDir}/build/deps/prefix/lib/qt6/qml"
      },
      "environment": {
        "QML_IMPORT_PATH": "${sourceDir}/build/deps/prefix/lib/qt6/qml",
        "LD_LIBRARY_PATH": "${sourceDir}/build/deps/prefix/lib"
      }
    },
    {
      "name": "test",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/test",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "BUILD_TESTING": "ON",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_PREFIX_PATH": "${sourceDir}/build/deps/prefix",
        "QML_IMPORT_PATH": "${sourceDir}/build/deps/prefix/lib/qt6/qml"
      },
      "environment": {
        "QML_IMPORT_PATH": "${sourceDir}/build/deps/prefix/lib/qt6/qml",
        "LD_LIBRARY_PATH": "${sourceDir}/build/deps/prefix/lib"
      }
    },
    {
      "name": "sanitizer",
      "inherits": "test",
      "binaryDir": "${sourceDir}/build/sanitizer",
      "cacheVariables": {
        "VIEWER_ENABLE_SANITIZERS": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug",
      "configurePreset": "debug",
      "jobs": 2
    },
    {
      "name": "release",
      "configurePreset": "release",
      "jobs": 2
    },
    {
      "name": "test",
      "configurePreset": "test",
      "jobs": 2
    },
    {
      "name": "sanitizer",
      "configurePreset": "sanitizer",
      "jobs": 2
    }
  ],
  "testPresets": [
    {
      "name": "test",
      "configurePreset": "test",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "sanitizer",
      "inherits": "test",
      "configurePreset": "sanitizer",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:halt_on_error=1",
        "UBSAN_OPTIONS": "halt_on_error=1:print_stacktrace=1"
      }
    }
  ]
}

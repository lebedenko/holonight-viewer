# Reuse the exact Qt runtime used to build providers (their private Qt ABI matters).
ARG VIEWER_CI_IMAGE=ghcr.io/lebedenko/holonight-shell-ci@sha256:4a1a177988c441c523bd31952a58953343ac8e6f031c7563e5b1e90ffb7d8bd6
FROM ${VIEWER_CI_IMAGE}
# Apply the same checksum-verified supplements as the build container, offline.
COPY packages/ /ci/packages/
COPY packages.json install-runtime-tools.py /ci/
RUN python3 /ci/install-runtime-tools.py
COPY payload/usr/ /usr/
COPY check/ /opt/check/
RUN ldconfig
WORKDIR /opt/check
CMD ["bash", "scripts/isolated-runtime.sh"]
